{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://credflow.example.test/events/event-envelope.schema.json",
  "title": "CredFlow event envelope",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "producer",
    "applicationId",
    "aggregateVersion",
    "correlationId",
    "actor",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string"
    },
    "applicationId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "originActor": {
      "$ref": "#/$defs/actor"
    },
    "data": {
      "type": "object"
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "required": [
        "type",
        "subject"
      ],
      "properties": {
        "type": {
          "enum": [
            "HUMAN",
            "SYSTEM_CLIENT",
            "SYSTEM"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "organisationId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}