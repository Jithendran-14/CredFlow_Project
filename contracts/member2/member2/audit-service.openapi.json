{
  "openapi": "3.0.3",
  "info": {
    "title": "CredFlow Audit history API",
    "version": "0.1.0",
    "description": "Implemented ADMIN-only safe application history for supported v1 application, eligibility, workflow, lender and offer events. Member 1 v2 and final Consent events await source integration."
  },
  "servers": [
    {
      "url": "http://localhost:8086"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/system/audit-service/info": {
      "get": {
        "responses": {
          "200": {
            "description": "Authenticated foundation metadata"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/actuator/health": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Healthy"
          },
          "503": {
            "description": "Unhealthy"
          }
        }
      }
    },
    "/api/v1/applications/{applicationId}/audit": {
      "get": {
        "summary": "ADMIN-only chronological safe application event history",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Safe supported events ordered by normalized occurrence time and event ID; empty array when none exist",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "ADMIN role required"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {}
  }
}
