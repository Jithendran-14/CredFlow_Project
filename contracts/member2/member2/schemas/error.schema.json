{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DRAFT Error v1",
  "description": "Proposal for team review. No corresponding business HTTP endpoint or event producer is implemented yet.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "fieldErrors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "field",
          "message"
        ]
      }
    }
  },
  "required": [
    "code",
    "message",
    "correlationId",
    "fieldErrors"
  ]
}