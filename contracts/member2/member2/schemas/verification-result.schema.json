{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DRAFT Verification provider result v1",
  "description": "Proposal for team review. No corresponding business HTTP endpoint or event producer is implemented yet.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verificationRequestId": {
      "type": "string",
      "format": "uuid"
    },
    "applicationId": {
      "type": "string",
      "format": "uuid"
    },
    "applicationRevision": {
      "type": "integer",
      "minimum": 1
    },
    "fixtureIdentityId": {
      "type": "string",
      "pattern": "^DEMO-[A-Z0-9-]{1,80}$"
    },
    "providerReference": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "VERIFIED",
        "FAILED",
        "PENDING",
        "ACTION_REQUIRED"
      ]
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "verificationRequestId",
    "applicationId",
    "applicationRevision",
    "fixtureIdentityId",
    "providerReference",
    "status",
    "message",
    "checkedAt"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "FAILED",
              "PENDING",
              "ACTION_REQUIRED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "reasonCode"
        ]
      }
    }
  ]
}