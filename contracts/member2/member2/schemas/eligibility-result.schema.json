{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DRAFT Eligibility result v1",
  "description": "Proposal for team review. No corresponding business HTTP endpoint or event producer is implemented yet.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eligibilityResultId": {
      "type": "string",
      "format": "uuid"
    },
    "evaluationRequestId": {
      "type": "string",
      "format": "uuid"
    },
    "applicationId": {
      "type": "string",
      "format": "uuid"
    },
    "applicationRevision": {
      "type": "integer",
      "minimum": 1
    },
    "verificationId": {
      "type": "string",
      "format": "uuid"
    },
    "financialSnapshotId": {
      "type": "string",
      "format": "uuid"
    },
    "calculationVersion": {
      "type": "string",
      "minLength": 1
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "asOfDate": {
      "type": "string",
      "format": "date"
    },
    "requestedAmount": {
      "type": "string",
      "pattern": "^[0-9]{1,17}\\.[0-9]{2}$"
    },
    "currency": {
      "const": "INR"
    },
    "outcome": {
      "enum": [
        "EVALUATED",
        "ACTION_REQUIRED"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "averageMonthlyNetSales": {
      "type": "string",
      "pattern": "^[0-9]{1,17}\\.[0-9]{2}$"
    },
    "averageMonthlyPayout": {
      "type": "string",
      "pattern": "^[0-9]{1,17}\\.[0-9]{2}$"
    },
    "returnRatePercent": {
      "type": "string",
      "pattern": "^[0-9]{1,3}\\.[0-9]{2}$"
    },
    "lenderResults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LenderResult"
      }
    },
    "creditScoreBand": {
      "type": [
        "string",
        "null"
      ]
    },
    "monthlySurplus": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "eligibilityResultId",
    "evaluationRequestId",
    "applicationId",
    "applicationRevision",
    "verificationId",
    "financialSnapshotId",
    "calculationVersion",
    "evaluatedAt",
    "asOfDate",
    "requestedAmount",
    "currency",
    "outcome",
    "reasonCodes",
    "lenderResults"
  ],
  "$defs": {
    "LenderResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lenderId": {
          "type": "string",
          "format": "uuid"
        },
        "productId": {
          "type": "string",
          "format": "uuid"
        },
        "ruleVersion": {
          "type": "string",
          "minLength": 1
        },
        "indicativeMaxAmount": {
          "type": "string",
          "pattern": "^[0-9]{1,17}\\.[0-9]{2}$"
        },
        "eligible": {
          "type": "boolean"
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "routingPriority": {
          "type": "integer"
        },
        "estimatedMonthlyPayment": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "lenderId",
        "productId",
        "ruleVersion",
        "indicativeMaxAmount",
        "eligible",
        "reasonCodes",
        "routingPriority"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "EVALUATED"
          }
        }
      },
      "then": {
        "required": [
          "averageMonthlyNetSales",
          "averageMonthlyPayout",
          "returnRatePercent"
        ],
        "properties": {
          "reasonCodes": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "lenderResults": {
            "maxItems": 0
          },
          "reasonCodes": {
            "minItems": 1
          },
          "creditScoreBand": {
            "type": [
              "string",
              "null"
            ]
          },
          "monthlySurplus": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "averageMonthlyNetSales"
              ]
            },
            {
              "required": [
                "averageMonthlyPayout"
              ]
            },
            {
              "required": [
                "returnRatePercent"
              ]
            }
          ]
        }
      }
    }
  ]
}