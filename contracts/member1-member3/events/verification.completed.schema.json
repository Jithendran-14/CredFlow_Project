{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://credflow.local/contracts/events/verification.completed.schema.json",
  "title": "verification.completed",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "verification.completed"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "consent-verification-service"
    },
    "applicationId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,100}$"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "properties": {
        "verificationId": {
          "type": "string",
          "format": "uuid"
        },
        "applicationRevision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "VERIFIED",
            "FAILED",
            "PENDING",
            "ACTION_REQUIRED"
          ]
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "providerReference": {
          "type": "string",
          "minLength": 1
        },
        "fixtureIdentityId": {
          "type": "string",
          "minLength": 1
        },
        "authorisedRetrievalReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "Opaque trusted financial retrieval reference issued by Consent and Verification after authorisation. Not the providerReference and not chosen by a seller."
        }
      },
      "required": [
        "verificationId",
        "applicationRevision",
        "status",
        "checkedAt",
        "fixtureIdentityId"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "FAILED",
                  "ACTION_REQUIRED"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reasonCode"
            ]
          }
        }
      ]
    },
    "actor": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "HUMAN",
            "SYSTEM",
            "SYSTEM_CLIENT"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "organisationId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "type",
        "subject"
      ],
      "additionalProperties": false
    },
    "originActor": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "HUMAN",
            "SYSTEM",
            "SYSTEM_CLIENT"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "organisationId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "type",
        "subject"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "producer",
    "applicationId",
    "aggregateVersion",
    "correlationId",
    "data",
    "actor"
  ],
  "additionalProperties": false,
  "description": "Proposed durable Consent and Verification event for Orchestration; distinct from the Member 2 identity-provider HTTP response. A VERIFIED event without authorisedRetrievalReference is recorded but cannot trigger Eligibility; Orchestration reports FINANCIAL_RETRIEVAL_REFERENCE_REQUIRED."
}