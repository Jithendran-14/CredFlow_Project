{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://credflow.local/contracts/events/consent.updated.schema.json",
  "title": "consent.updated",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "consent.updated"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "consent-verification-service"
    },
    "applicationId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,100}$"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "properties": {
        "consentId": {
          "type": "string",
          "format": "uuid"
        },
        "consentVersion": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "GRANTED",
            "DECLINED",
            "REVOKED"
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "enum": [
              "MARKETPLACE_DATA_READ",
              "IDENTITY_VERIFICATION",
              "LENDER_APPLICATION_SHARE"
            ]
          },
          "minItems": 0
        },
        "sourceMarketplaceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 0
        },
        "recipientLenderIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 0
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "validityPolicy": {
          "const": "APPLICATION_OPEN"
        },
        "noticeVersion": {
          "type": "string",
          "minLength": 1
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        },
        "revokedAt": {
          "type": "string",
          "format": "date-time"
        },
        "operationId": {
          "type": "string",
          "format": "uuid"
        },
        "originActor": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "HUMAN",
                "SYSTEM",
                "SYSTEM_CLIENT"
              ]
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "organisationId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "type",
            "subject"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "consentId",
        "consentVersion",
        "status",
        "scopes",
        "sourceMarketplaceIds",
        "recipientLenderIds",
        "purpose",
        "validityPolicy"
      ],
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "HUMAN",
            "SYSTEM",
            "SYSTEM_CLIENT"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "organisationId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "type",
        "subject"
      ],
      "additionalProperties": false
    },
    "originActor": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "HUMAN",
            "SYSTEM",
            "SYSTEM_CLIENT"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "organisationId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "type",
        "subject"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "producer",
    "applicationId",
    "aggregateVersion",
    "correlationId",
    "data",
    "actor"
  ],
  "additionalProperties": false
}