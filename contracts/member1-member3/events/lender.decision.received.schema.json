{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://credflow.local/contracts/events/lender.decision.received.schema.json",
  "title": "lender.decision.received",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "lender.decision.received"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "lender-integration-service"
    },
    "applicationId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,100}$"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "properties": {
        "applicationId": {
          "type": "string",
          "format": "uuid"
        },
        "submissionId": {
          "type": "string",
          "format": "uuid"
        },
        "applicationRevision": {
          "type": "integer",
          "minimum": 1
        },
        "lenderId": {
          "type": "string",
          "format": "uuid"
        },
        "lenderApplicationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "originActor": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "HUMAN",
                "SYSTEM",
                "SYSTEM_CLIENT"
              ]
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "organisationId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "type",
            "subject"
          ],
          "additionalProperties": false
        },
        "correlationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,100}$"
        },
        "causationId": {
          "type": "string",
          "format": "uuid"
        },
        "decisionId": {
          "type": "string",
          "format": "uuid"
        },
        "decision": {
          "enum": [
            "APPROVED",
            "REJECTED",
            "MANUAL_REVIEW",
            "ACTION_REQUIRED"
          ]
        },
        "decidedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "reasonText": {
          "type": "string",
          "minLength": 1
        },
        "offer": {
          "type": "object",
          "properties": {
            "offerId": {
              "type": "string",
              "format": "uuid"
            },
            "offeredAmount": {
              "type": "string",
              "pattern": "^[0-9]{1,17}\\.[0-9]{2}$",
              "not": {
                "pattern": "^0+\\.00$"
              }
            },
            "currency": {
              "const": "INR"
            },
            "annualInterestRatePercent": {
              "type": "string",
              "pattern": "^(100(\\.0{1,4})?|0?[0-9]{1,2}(\\.[0-9]{1,4})?)$"
            },
            "interestRateType": {
              "const": "FIXED"
            },
            "tenureMonths": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            },
            "repaymentFrequency": {
              "const": "MONTHLY"
            },
            "feesAmount": {
              "type": "string",
              "pattern": "^[0-9]{1,17}\\.[0-9]{2}$"
            },
            "termsReference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            },
            "version": {
              "const": 0
            }
          },
          "required": [
            "offerId",
            "offeredAmount",
            "currency",
            "annualInterestRatePercent",
            "interestRateType",
            "tenureMonths",
            "repaymentFrequency",
            "feesAmount",
            "termsReference",
            "expiresAt",
            "version"
          ],
          "additionalProperties": false
        },
        "informationRequestId": {
          "type": "string",
          "format": "uuid"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "questionId": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "questionId",
              "prompt"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 50
        }
      },
      "required": [
        "submissionId",
        "applicationRevision",
        "lenderId",
        "lenderApplicationId",
        "decisionId",
        "decision",
        "decidedAt"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "REJECTED"
              }
            }
          },
          "then": {
            "required": [
              "reasonCode"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "const": "ACTION_REQUIRED"
              }
            }
          },
          "then": {
            "required": [
              "informationRequestId",
              "questions"
            ]
          }
        }
      ]
    },
    "actor": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "HUMAN",
            "SYSTEM",
            "SYSTEM_CLIENT"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "organisationId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "type",
        "subject"
      ],
      "additionalProperties": false
    },
    "originActor": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "HUMAN",
            "SYSTEM",
            "SYSTEM_CLIENT"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "organisationId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "type",
        "subject"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "producer",
    "applicationId",
    "aggregateVersion",
    "correlationId",
    "data",
    "actor"
  ],
  "additionalProperties": false
}