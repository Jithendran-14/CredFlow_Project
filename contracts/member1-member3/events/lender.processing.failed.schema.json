        "decisionId": {
          "type": "string",
          "format": "uuid"
        },
        "informationRequestId": {
          "type": "string",
          "format": "uuid"
        },
        "offerId": {
          "type": "string",
          "format": "uuid"
        },
        "acceptanceId": {
          "type": "string",
          "format": "uuid"
        },
        "cancellationId": {
          "type": "string",
          "format": "uuid"
