          "type": "string",
          "format": "uuid"
        },
        "lenderApplicationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "originActor": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "HUMAN",
                "SYSTEM",
                "SYSTEM_CLIENT"
              ]
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "organisationId": {
              "type": "string",
              "format": "uuid"
