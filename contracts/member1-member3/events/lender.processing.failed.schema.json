          "enum": [
            "SUBMIT",
            "DECISION",
            "REQUEST_INFORMATION",
            "ANSWER_INFORMATION",
            "CREATE_OFFER",
            "WITHDRAW_OFFER",
            "ACCEPT_OFFER",
            "DECLINE_OFFER",
            "CANCEL",
            "CALLBACK"
