credflow.events.enabled=false
credflow.oauth.clients.system.client-id=mock-bank-c
credflow.oauth.clients.system.client-secret=CHANGE_ME
credflow.oauth.clients.bank-c-callback.client-id=mock-bank-c
credflow.oauth.clients.bank-c-callback.client-secret=CHANGE_ME
