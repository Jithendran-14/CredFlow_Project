server.address=127.0.0.1
spring.datasource.url=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
spring.datasource.username=CF_ORCHESTRATION
spring.datasource.password=CHANGE_ME
spring.jpa.hibernate.ddl-auto=validate
spring.kafka.bootstrap-servers=127.0.0.1:9092
credflow.security.issuer=credflow-auth
credflow.security.audience=credflow-api
credflow.security.public-key-location=file:C:/credflow/CredFlow/backend/runtime/private/auth-public.pem
credflow.security.jwk-set-uri=
credflow.security.role-mode=FLAT
credflow.oauth.token-url=http://127.0.0.1:8085/oauth2/token
credflow.events.enabled=true
spring.kafka.listener.auto-startup=true
credflow.delivery.poll-ms=500
credflow.oauth.clients.system.client-id=orchestration-service
credflow.oauth.clients.system.client-secret=CHANGE_ME
credflow.oauth.clients.consent.client-id=orchestration-service
credflow.oauth.clients.consent.client-secret=CHANGE_ME
credflow.oauth.clients.application.client-id=orchestration-service
credflow.oauth.clients.application.client-secret=CHANGE_ME
credflow.oauth.clients.integration.client-id=orchestration-service
credflow.oauth.clients.integration.client-secret=CHANGE_ME
credflow.oauth.clients.orchestration.client-id=orchestration-service
credflow.oauth.clients.orchestration.client-secret=CHANGE_ME
credflow.oauth.clients.simulator.client-id=orchestration-service
credflow.oauth.clients.simulator.client-secret=CHANGE_ME
credflow.oauth.clients.bank-a-callback.client-id=orchestration-service
credflow.oauth.clients.bank-a-callback.client-secret=CHANGE_ME
credflow.oauth.clients.nbfc-b-callback.client-id=orchestration-service
credflow.oauth.clients.nbfc-b-callback.client-secret=CHANGE_ME
credflow.oauth.clients.eligibility.client-id=orchestration-service
credflow.oauth.clients.eligibility.client-secret=CHANGE_ME
