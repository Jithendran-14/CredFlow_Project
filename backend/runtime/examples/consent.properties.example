server.address=127.0.0.1
spring.datasource.url=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
spring.datasource.username=CF_CONSENT
spring.datasource.password=CHANGE_ME
spring.jpa.hibernate.ddl-auto=validate
spring.kafka.bootstrap-servers=127.0.0.1:9092
credflow.jwt.issuer=credflow-auth
credflow.jwt.audience=credflow-api
credflow.jwt.public-key-path=C:/credflow/CredFlow/backend/runtime/private/auth-public.pem
credflow.clients.auth.client-secret=CHANGE_ME
credflow.consent-delivery.enabled=true
credflow.consent-delivery.fixed-delay-ms=1000
credflow.identity-processing.enabled=true
credflow.verification-precheck.enabled=true
credflow.outbox.enabled=true
credflow.clients.financial.provider-url=http://127.0.0.1:8090/internal/v1/financial-data/retrievals
credflow.identity-processing.fixed-delay-ms=1000
credflow.identity-preparation.fixed-delay-ms=1000
credflow.verification-finalization.fixed-delay-ms=1000
credflow.outbox.fixed-delay-ms=1000
