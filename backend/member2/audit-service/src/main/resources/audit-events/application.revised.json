{
  "eventType": "application.revised",
  "producer": "application-service",
  "required": [
    "operationId",
    "applicationRevision",
    "previousRevision",
    "requestedAmount",
    "currency",
    "loanPurpose"
  ],
  "fields": {
    "operationId": {
      "type": "string",
      "format": "uuid"
    },
    "applicationRevision": {
      "type": "integer",
      "minimum": 1
    },
    "previousRevision": {
      "type": "integer",
      "minimum": 1
    },
    "requestedAmount": {
      "type": "string",
      "pattern": "^[0-9]{1,17}\\.[0-9]{2}$"
    },
    "currency": {
      "const": "INR"
    },
    "loanPurpose": {
      "enum": [
        "WORKING_CAPITAL",
        "PURCHASE_INVENTORY",
        "BUSINESS_EXPANSION"
      ]
    }
  }
}