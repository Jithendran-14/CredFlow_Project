{
  "eventType": "lender.decision.received",
  "producer": "lender-integration-service",
  "required": [
    "submissionId",
    "applicationRevision",
    "lenderId",
    "lenderApplicationId",
    "decisionId",
    "decision",
    "decidedAt"
  ],
  "fields": {
    "applicationId": {
      "type": "string",
      "format": "uuid"
    },
    "submissionId": {
      "type": "string",
      "format": "uuid"
    },
    "applicationRevision": {
      "type": "integer",
      "minimum": 1
    },
    "lenderId": {
      "type": "string",
      "format": "uuid"
    },
    "lenderApplicationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "decisionId": {
      "type": "string",
      "format": "uuid"
    },
    "decision": {
      "enum": [
        "APPROVED",
        "REJECTED",
        "MANUAL_REVIEW",
        "INFORMATION_REQUIRED"
      ]
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1
    },
    "informationRequestId": {
      "type": "string",
      "format": "uuid"
    }
  }
}
