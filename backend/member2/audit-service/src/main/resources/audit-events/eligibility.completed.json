{
  "eventType": "eligibility.completed",
  "producer": "eligibility-service",
  "required": [
    "eligibilityResultId",
    "applicationRevision",
    "verificationId",
    "financialSnapshotId",
    "evaluationRequestId",
    "calculationVersion",
    "evaluatedAt",
    "outcome",
    "reasonCodes",
    "lenderResults",
    "applicationId",
    "asOfDate",
    "requestedAmount",
    "currency"
  ],
  "fields": {
    "eligibilityResultId": {
      "type": "string",
      "format": "uuid"
    },
    "applicationRevision": {
      "type": "integer",
      "minimum": 1
    },
    "verificationId": {
      "type": "string",
      "format": "uuid"
    },
    "financialSnapshotId": {
      "type": "string",
      "format": "uuid"
    },
    "evaluationRequestId": {
      "type": "string",
      "format": "uuid"
    },
    "calculationVersion": {
      "type": "string",
      "minLength": 1
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "EVALUATED",
        "ACTION_REQUIRED"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "applicationId": {
      "type": "string",
      "format": "uuid"
    },
    "asOfDate": {
      "type": "string",
      "format": "date"
    },
    "requestedAmount": {
      "type": "string",
      "pattern": "^[0-9]{1,17}\\.[0-9]{2}$",
      "not": {
        "pattern": "^0+\\.00$"
      }
    },
    "currency": {
      "const": "INR"
    }
  }
}
