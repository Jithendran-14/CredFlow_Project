{
  "eventType": "lender.application.submitted",
  "producer": "lender-integration-service",
  "required": [
    "submissionId",
    "applicationRevision",
    "lenderId",
    "lenderApplicationId"
  ],
  "fields": {
    "applicationId": {
      "type": "string",
      "format": "uuid"
    },
    "submissionId": {
      "type": "string",
      "format": "uuid"
    },
    "applicationRevision": {
      "type": "integer",
      "minimum": 1
    },
    "lenderId": {
      "type": "string",
      "format": "uuid"
    },
    "lenderApplicationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time"
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
