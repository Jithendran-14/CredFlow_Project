{
  "eventType": "loan.offer.accepted",
  "producer": "orchestration-service",
  "required": [
    "offerId",
    "submissionId",
    "applicationRevision",
    "lenderId",
    "operationAt",
    "expectedOfferVersion",
    "lenderAcknowledgementStatus",
    "acceptanceId",
    "acceptedAt"
  ],
  "fields": {
    "offerId": {
      "type": "string",
      "format": "uuid"
    },
    "submissionId": {
      "type": "string",
      "format": "uuid"
    },
    "applicationRevision": {
      "type": "integer",
      "minimum": 1
    },
    "lenderId": {
      "type": "string",
      "format": "uuid"
    },
    "operationAt": {
      "type": "string",
      "format": "date-time"
    },
    "expectedOfferVersion": {
      "type": "integer",
      "minimum": 0
    },
    "lenderAcknowledgementStatus": {
      "enum": [
        "PENDING",
        "ACKNOWLEDGED",
        "FAILED"
      ]
    },
    "acceptanceId": {
      "type": "string",
      "format": "uuid"
    },
    "acceptedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
