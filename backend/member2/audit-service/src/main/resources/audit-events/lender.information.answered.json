{
  "eventType": "lender.information.answered",
  "producer": "lender-integration-service",
  "required": [
    "submissionId",
    "applicationRevision",
    "lenderId",
    "lenderApplicationId",
    "informationRequestId"
  ],
  "fields": {
    "applicationId": {
      "type": "string",
      "format": "uuid"
    },
    "submissionId": {
      "type": "string",
      "format": "uuid"
    },
    "applicationRevision": {
      "type": "integer",
      "minimum": 1
    },
    "lenderId": {
      "type": "string",
      "format": "uuid"
    },
    "lenderApplicationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "informationRequestId": {
      "type": "string",
      "format": "uuid"
    },
    "answeredAt": {
      "type": "string",
      "format": "date-time"
    },
    "lenderAcknowledgementStatus": {
      "enum": [
        "ACKNOWLEDGED",
        "FAILED"
      ]
    }
  }
}
