{
  "eventType": "loan.offer.created",
  "producer": "lender-integration-service",
  "required": [
    "submissionId",
    "applicationRevision",
    "lenderId",
    "lenderApplicationId",
    "offerId",
    "offeredAmount",
    "currency",
    "annualInterestRatePercent",
    "interestRateType",
    "tenureMonths",
    "repaymentFrequency",
    "feesAmount",
    "termsReference",
    "expiresAt",
    "version"
  ],
  "fields": {
    "applicationId": {
      "type": "string",
      "format": "uuid"
    },
    "submissionId": {
      "type": "string",
      "format": "uuid"
    },
    "applicationRevision": {
      "type": "integer",
      "minimum": 1
    },
    "lenderId": {
      "type": "string",
      "format": "uuid"
    },
    "lenderApplicationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "offerId": {
      "type": "string",
      "format": "uuid"
    },
    "offeredAmount": {
      "type": "string",
      "pattern": "^[0-9]{1,17}\\.[0-9]{2}$",
      "not": {
        "pattern": "^0+\\.00$"
      }
    },
    "currency": {
      "const": "INR"
    },
    "annualInterestRatePercent": {
      "type": "string",
      "pattern": "^(100(\\.0{1,4})?|0?[0-9]{1,2}(\\.[0-9]{1,4})?)$"
    },
    "interestRateType": {
      "const": "FIXED"
    },
    "tenureMonths": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "repaymentFrequency": {
      "const": "MONTHLY"
    },
    "feesAmount": {
      "type": "string",
      "pattern": "^[0-9]{1,17}\\.[0-9]{2}$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "const": 0
    },
    "status": {
      "const": "ACTIVE"
    }
  }
}
